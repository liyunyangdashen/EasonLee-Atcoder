#include<iostream>
#include<utility>
#include<algorithm>
using namespace std; using ll = long long; using pii = pair<ll,ll>; const int N = 105;
ll n,d,cnt = 0,ans[N]; pii a[N];
int main(){
  ios::sync_with_stdio(0);
  cin.tie(0);
  cout.tie(0);
  cin >> n >> d;
  a[0].first = -1e18;
  a[n + 1].first = 1e18;
  for (int i = 1;i <= n;i++){
    cin >> a[i].first;
    a[i].second = i;
  }
  sort(a + 1,a + n + 1);
  for (int i = 1;i <= n;i++)
    if (a[i + 1].first - a[i].first >= d && a[i].first - a[i - 1].first >= d)
      ans[++cnt] = a[i].second;
  cout << cnt << '\n';
  sort(ans + 1,ans + cnt + 1);
  for (int i = 1;i <= cnt;i++)
    cout << ans[i] << ' ';
  return 0;
}
