#include<iostream>
#include<cmath>
#include<iomanip>
using namespace std; const int N = 105;
int n,x[N],y[N]; double ans = 0;
int main(){
  ios::sync_with_stdio(0);
  cin.tie(0);
  cout.tie(0);
  cin >> n;
  for (int i = 1;i <= n;i++){
    cin >> x[i] >> y[i];
    for (int j = 1;j < i;j++)
      ans = max(ans,sqrt(pow(x[i] - x[j],2) + pow(y[i] - y[j],2)));
  }
  cout << fixed << setprecision(10) << ans;
  return 0;
}
