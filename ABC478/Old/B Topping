#include<iostream>
using namespace std; const int N = 105;
int n,v,w[N],ans = -2e9;
int main(){
  ios::sync_with_stdio(0);
  cin.tie(0);
  cout.tie(0);
  cin >> n >> v;
  for (int i = 1;i <= n;i++)
    cin >> w[i];
  for (int i = 1;i <= n;i++)
    for (int j = i + 1;j <= n;j++)
      for (int k = j + 1;k <= n;k++)
        if (i + j + k <= v)
          ans = max(ans,w[i] + w[j] + w[k]);
  cout << ans;
  return 0;
}
